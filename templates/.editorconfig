# EditorConfig is awesome: https://EditorConfig.org
# Checked by checklist-dev-editorconfig (editorconfig-checker).

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
quote_type = double
tab_width = 2
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{tf,tfvars}]
indent_size = 2
indent_style = space

[*.md]
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = false

[Makefile]
tab_width = 2
indent_style = tab

# `off`, not 0. max_line_length is not an EditorConfig specification
# property at all, so 0 means whatever each tool decides it means. `off` is
# the documented spelling for the tools that implement the extension.
[COMMIT_EDITMSG]
max_line_length = off

[*.py]
max_line_length = 88

[*.json]
indent_size = 2
max_line_length = 100

[*.{bash,sh}]
indent_size = 2
quote_type = ignore
