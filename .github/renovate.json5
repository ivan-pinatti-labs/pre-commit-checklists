{
  // cspell:words zizmor pypi
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate is the sole dependency update bot in this repository.
  // Dependabot used to own two surfaces, the root .pre-commit-config.yaml's
  // pre-commit ecosystem and the github-actions ecosystem, and this file
  // used to exist only to close the one gap that left: every checklist
  // under checklists/ is its own standalone pre-commit config
  // (checklist-basic.yaml, checklist-dev-python.yaml, and so on), consumed
  // indirectly through scripts/run-checklist.sh, and Dependabot's
  // pre-commit ecosystem only ever reads a file literally named
  // .pre-commit-config.yaml, never a directory of differently named ones.
  // .github/dependabot.yml is gone now, and Renovate covers every pin
  // surface this repository has; see enabledManagers below for the four
  // that matter.
  extends: ["config:recommended"],

  // config:recommended enables a standing "Dependency Dashboard" issue that
  // never resolves on its own; PRs still open on the normal schedule below
  // without it, this just drops the one consolidated overview issue.
  // Enabled deliberately. With the dashboard off, "nothing to update" and
  // "Renovate silently stopped seeing these dependencies" look identical.
  // Dependabot discarded every candidate release in this repository for days
  // because of GitHub's undocumented three day cooldown default, and it
  // presented exactly as everything being current. The dashboard is the only
  // place Renovate surfaces detection errors and rate limited updates, which
  // matters most for the custom managers below, since those depend on hand
  // written patterns that match nothing if a file is renamed.
  dependencyDashboard: true,

  timezone: "America/Toronto",

  // Daily. A pin-only bump spends no CodeRabbit review quota: `Pin Only`
  // passing resolves `Review Verified` straight to `success` through
  // scripts/coderabbit-review-verdict.py's bot lane, with CodeRabbit never
  // asked for an opinion, which is why the org's per-repository day table
  // was dropped on 2026-09-02 in favour of checking daily everywhere. See
  // ivan-pinatti-labs/.github's README.md, "Dependency policy".
  //
  // Weekly, stacked against minimumReleaseAge's 7 day window below, means a
  // release that misses one week's slot by a day waits a full extra week
  // for the next one, so the oldest a package could sit before merging was
  // up to 14 days even though 7 was the intended floor: the same reasoning
  // rsync-crypt's own renovate.json5 documents for the same move from
  // weekly to daily. Checking daily keeps the schedule's own period short
  // enough that it can no longer add more than a day on top of that floor.
  schedule: ["before 7am"],

  labels: ["dependencies", "pre-commit"],
  commitMessagePrefix: "chore:",

  // Keep PR volume manageable.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // The default deny. Overridden per update type by the first packageRules
  // entry below, which is the only place that grants it: an update type this
  // config has not thought about arrives unlabelled and waits for a person
  // rather than merging on the strength of a default nobody chose.
  automerge: false,

  // Four managers, matching the four pin surfaces real to this repository
  // (see scripts/assert-pin-only-diff.py's own docstring for the same
  // list from the grading side). Every other manager config:recommended
  // would otherwise turn on is disabled, so Renovate never starts watching
  // a fifth surface nobody has reviewed the implications of. "asdf" watches
  // this repository's own .tool-versions (currently just
  // `pre-commit 4.5.1`). "pre-commit" watches every `rev:` pin, both the
  // root .pre-commit-config.yaml and every checklists/checklist-*.yaml file,
  // see that manager's own config below for how the two are covered.
  // "github-actions" watches every `uses: ...@<sha> # vX.Y.Z` pin under
  // .github/workflows/. "custom.regex" watches the three checklist-embedded
  // version strings the built-in pre-commit manager cannot see, and the asdf
  // plugin commits in .devcontainer/asdf-plugins (see customManagers below).
  // The plugin commits are the one surface scripts/assert-pin-only-diff.py
  // does not grade as a pin, deliberately: a plugin change is code, and
  // `Pin Only` sending it to a person is the intended outcome.
  enabledManagers: ["asdf", "pre-commit", "custom.regex", "github-actions"],

  // A cooling window before an update is offered at all, mirroring
  // rsync-crypt's own reasoning (itself mirroring docker-torrent-box-with-vpn's,
  // chosen for a much larger fleet of container images): `Pin Only` proves a
  // diff changed nothing but a version token, and says so in its own
  // docstring, but it cannot tell a good release from a backdoored one,
  // because a fresh supply chain attack has no advisory yet for any scanner
  // to match. Age is the only defence against that, and granting automerge
  // below without it would mean merging a release published minutes
  // earlier, unattended, with no person ever looking.
  //
  // Seven days, the same as rsync-crypt, not because the number was copied
  // but because the reasoning is not about fleet size: most compromised
  // releases are spotted and pulled within hours to days regardless of how
  // many tools or hooks a repository tracks, so the window that makes "we
  // merged it first" into "it was already yanked" is the same window here
  // as there.
  minimumReleaseAge: "7 days",

  // Hold the pull request until the window is satisfied rather than opening
  // one that is not allowed to merge yet. Without this, minimumReleaseAge
  // still gates the merge, but Renovate opens the pull request immediately
  // regardless, so it would sit for up to seven days looking blocked for no
  // visible reason instead of not existing yet.
  internalChecksFilter: "strict",

  // The exception: a fix for a known vulnerability is not made safer by
  // aging, and null clears the inherited window for these updates only.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    // What may merge without anyone looking, and the label that says so.
    //
    // First in the list on purpose, the same reason it is first in
    // rsync-crypt's copy of this file: later rules win on any key they share
    // with an earlier one, and the group rule below sets a name and labels,
    // not automerge policy, so it cannot accidentally override this by
    // coming after it.
    //
    // The label is the whole point. bot-auto-merge.yml approves a Renovate
    // pull request only when it carries `automerge`, reading the label
    // rather than restating which update types are eligible, so the policy
    // lives here, once, instead of two copies free to drift apart. `Pin
    // Only` is the actual security gate behind that trust: every changed
    // line still has to be nothing but a version in a pin position, checked
    // line by line by scripts/assert-pin-only-diff.py, before the label
    // alone can do anything.
    //
    // patch and minor only, not this repository's whole update-type
    // vocabulary. A major bump is exactly the case that needs a person: the
    // three checklist-embedded custom.regex pins and the asdf `pre-commit`
    // pin can all offer one, and a checklist's own upstream hook can rename
    // or remove a hook id across a major release the same way this
    // library's own versioning contract does (see docs/versioning.md).
    //
    // matchCurrentVersion excludes 0.x packages from that grant, since
    // semver makes no breaking-change promise below 1.0 and a "minor" bump
    // there is exactly as likely to break something as a major bump
    // elsewhere. This repository actually carries 0.x pins today
    // (checklists/checklist-dev-terraform.yaml's gruntwork-io/pre-commit at
    // v0.1.30, among others), so this is not a defensive rule against a
    // hypothetical: without it, a 0.x package's next "minor" release would
    // merge unattended on the strength of a version scheme that package has
    // not opted into providing any stability guarantee under.
    {
      matchUpdateTypes: ["patch", "minor"],
      matchCurrentVersion: "!/^0\\./",
      automerge: true,
      addLabels: ["automerge"],
    },
    {
      matchManagers: ["asdf"],
      groupName: "asdf tool versions",
      groupSlug: "asdf-tools",
      labels: ["dependencies", "tooling"],
    },
    // An asdf plugin is code: `asdf install` runs its scripts to download and
    // install each tool, inside a development container that holds a GitHub
    // token. A new plugin commit therefore waits for a person to read what
    // changed in that plugin, and never merges on its own. It is a digest
    // update, which the automerge rule above never matches either.
    //
    // git-refs publishes no release timestamps, and under Renovate's default
    // minimumReleaseAgeBehaviour (timestamp-required) the 7 day window above
    // would then hold every plugin commit back forever, silently.
    // timestamp-optional lets the update be offered; the review stands in for
    // the age window here.
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["git-refs"],
      matchFileNames: [".devcontainer/asdf-plugins"],
      groupName: "asdf plugins",
      groupSlug: "asdf-plugins",
      labels: ["dependencies", "tooling"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: false,
    },
    // One pull request for every action bump, matching the shape
    // dependabot.yml used to give this ecosystem
    // (groups: github-actions: patterns: ["*"]) before it was deleted. The
    // root .pre-commit-config.yaml's own pin surface stays ungrouped, one
    // pull request per hook, the same as it was under Dependabot and the
    // same as checklists/ already is under Renovate's pre-commit manager;
    // this rule names github-actions specifically so that shape is not
    // disturbed.
    //
    // addLabels, not labels: labels replaces the top level labels array
    // outright (confirmed against Renovate's own configuration options
    // documentation), and the point here is to add github-actions on top of
    // dependencies and pre-commit above, matching what the label set on a
    // grouped Dependabot github-actions pull request used to be
    // (dependencies, github-actions), not to drop the labels every other
    // Renovate pull request in this repository already carries.
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      groupSlug: "github-actions",
      addLabels: ["github-actions"],
    },
    // The github-actions manager extracts more than `uses: ...@<sha>` action
    // pins by default: confirmed live, with a dry-run=extract against this
    // repository, it also proposes updates for every `runs-on: ubuntu-24.04`
    // (depType github-runner) and every `python-version: "3.12"` passed to
    // actions/setup-python's `with:` (depType uses-with). Dependabot's
    // github-actions ecosystem never watched either: it bumps `uses:` pins
    // only. docker, container and service are the manager's three other
    // known depTypes (a `uses: docker://...` line, a job's `services:`
    // block, and a job's `container:` block, respectively; see Renovate's
    // own github-actions manager documentation), none of which this
    // repository's workflows use today, confirmed with a repository wide
    // search, but Dependabot never watched any of those either, so they are
    // disabled alongside the two found live, not left to start being
    // proposed silently the day a workflow first adds one. Disabled here so
    // this migration hands Renovate exactly the scope Dependabot had, not a
    // wider one nobody has reviewed the implications of. Nothing downstream
    // would have merged one of these unattended regardless:
    // scripts/assert-pin-only-diff.py's REV_PIN and ACTION_SHA patterns do
    // not match any of the five, so `Pin Only` would have refused any such
    // diff and sent it to a person, same as a major bump. This rule stops
    // the pull request from being opened at all, rather than relying on
    // that fallback for something that was never in scope.
    {
      matchManagers: ["github-actions"],
      matchDepTypes: [
        "github-runner",
        "uses-with",
        "docker",
        "container",
        "service",
      ],
      enabled: false,
    },
  ],

  // The built-in pre-commit manager now covers both of this repository's
  // pre-commit surfaces: the root .pre-commit-config.yaml (this repo's own
  // dogfood config, formerly Dependabot's) and every
  // checklists/checklist-*.yaml file (this library's actual product).
  //
  // managerFilePatterns is additive, not a replacement for the manager's
  // own default match (confirmed against Renovate's own documentation and,
  // live, with a dry-run=extract against this repository): the default
  // pattern /(^|/)\.pre-commit-config\.ya?ml$/ still applies alongside the
  // pattern below, so the root file is covered without needing to be named
  // here at all. The explicit pattern below exists only to reach
  // checklists/checklist-*.yaml, which does not match the default (those
  // files are not literally named .pre-commit-config.yaml) and would
  // otherwise go unwatched.
  //
  // No ignorePaths any more. It used to exclude the root file specifically
  // so Dependabot's pre-commit ecosystem could own it without this manager
  // opening a competing pull request for the same rev: pin; now that
  // Renovate is the only bot watching either surface, there is nothing left
  // to exclude it from.
  //
  // enabled: true is required and easy to miss: unlike most Renovate
  // managers, the pre-commit manager's own defaultConfig ships
  // `enabled: false` (confirmed by reading
  // node_modules/renovate/dist/modules/manager/pre-commit/index.js after a
  // live dry-run=extract against this repository showed zero pre-commit
  // matches despite "pre-commit" already being listed in enabledManagers
  // above). enabledManagers only controls which managers are allowed to run
  // at all; it does not flip an individually-disabled manager back on. The
  // customManagers below need no such key: customType: "regex" managers
  // have no per-manager enabled default to override.
  "pre-commit": {
    enabled: true,
    managerFilePatterns: ["/^checklists/checklist-.+\\.ya?ml$/"],
  },

  // checklist-dev-dotenv.yaml is a `repo: local` hook (see
  // docs/hook-catalogue.md#which-dotenv-linter for why), so it has no
  // `rev:` field for the manager above to watch. Its pin is the image tag
  // inside its own entry: string instead; this custom manager watches
  // that tag the same way, so it does not rot silently either.
  // checklist-github-actions.yaml's zizmor hook is also `repo: local` (see
  // docs/hook-catalogue.md and that checklist's own header comment for
  // why), so it too has no `rev:` field for the manager above to watch.
  // Its pin lives inside additional_dependencies instead, as a normal
  // PyPI version pin; this custom manager watches that the same way the
  // one above watches the dotenv-linter image tag.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^checklists/checklist-dev-dotenv\\.ya?ml$/"],
      matchStrings: [
        "docker\\.io/dotenvlinter/dotenv-linter:(?<currentValue>[0-9.]+)",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "dotenvlinter/dotenv-linter",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^checklists/checklist-github-actions\\.ya?ml$/"],
      matchStrings: ["zizmor==(?<currentValue>[0-9.]+)"],
      datasourceTemplate: "pypi",
      depNameTemplate: "zizmor",
    },
    {
      // markdown-link-check is a repo: local hook so the checklist can pass
      // --config conditionally, which leaves no rev: field for the built-in
      // pre-commit manager to watch. Same arrangement as the two above.
      customType: "regex",
      managerFilePatterns: ["/^checklists/checklist-markdown\\.ya?ml$/"],
      matchStrings: ["markdown-link-check@(?<currentValue>[0-9.]+)"],
      datasourceTemplate: "npm",
      depNameTemplate: "markdown-link-check",
    },
    {
      // The asdf plugin commits the development container pins in
      // .devcontainer/asdf-plugins, one line per plugin: name, repository
      // URL, branch, commit. git-refs reads the named branch's current
      // commit, so a new commit there arrives as a digest update to that
      // line. See the matching packageRules entry for why a person reviews
      // every one.
      customType: "regex",
      managerFilePatterns: ["/^\\.devcontainer/asdf-plugins$/"],
      matchStrings: [
        "(?<depName>[a-z0-9-]+) (?<packageName>https://\\S+) (?<currentValue>\\S+) (?<currentDigest>[0-9a-f]{40})",
      ],
      datasourceTemplate: "git-refs",
    },
  ],
}
